    "report": {
      "permissions": {"source": "job", "mode": "explicit", "scopes": {"checks": "write", "issues": "write", "statuses": "write"}},
      "findings": [],
      "notes": ["CALLER_CONTEXT"]
    }
  },
  "exit_code": 0
}
